function fmtNum(n) {
  if (n === undefined || n === null) return '—';
  return Number(n).toLocaleString();
}
function fmtCell(col, val) {
  if (val === undefined || val === null) return '—';
  if (col.pct) return Number(val).toLocaleString() + '%';
  return Number(val).toLocaleString();
}
function labelForRow(view, row) {
  if (view === 'gender') return GENDER_LABEL[row.key] || row.label;
  if (view === 'placement') return POSITION_LABEL[row.key] || row.label;
  return row.label;
}

/* ---------------- 欄位排序：點表頭切換遞增/遞減，不用重新打 API ---------------- */
function applySort(data, view) {
  if (!sortState.key || !data || !data.rows) return data;
  const rows = [...data.rows];
  rows.sort((a, b) => {
    let av, bv;
    if (sortState.key === '__label') {
      av = String(labelForRow(view, a));
      bv = String(labelForRow(view, b));
      const cmp = av.localeCompare(bv, 'zh-Hant');
      return sortState.dir === 'asc' ? cmp : -cmp;
    }
    av = a[sortState.key] || 0;
    bv = b[sortState.key] || 0;
    return sortState.dir === 'asc' ? av - bv : bv - av;
  });
  return { rows, totals: data.totals };
}

function renderTableSorted(entry) {
  lastRender = entry;
  const sortedData = applySort(entry.data, entry.view);
  renderStatsStrip(entry.data.totals);
  renderTable(entry.view, sortedData, entry.isSnapshot, entry.snapshot, entry.ctx);
}

// 幫表格的 <th> 加上可點擊排序：data-sort-key="__label" 或 METRIC_COLS 的 key
function attachSortHandlers(wrapEl, view) {
  wrapEl.querySelectorAll('th[data-sort-key]').forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.sortKey;
      if (sortState.key === key) {
        sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
      } else {
        sortState.key = key;
        sortState.dir = 'desc';
      }
      if (lastRender) renderTableSorted(lastRender);
    });
  });
}

function sortArrow(key) {
  if (sortState.key !== key) return '';
  return sortState.dir === 'asc' ? ' ▲' : ' ▼';
}

function getActiveProject() {
  return PROJECTS.find((p) => p.id === state.projectId);
}

const PROJECT_ORDER_KEY = 'project_order_v1';
function getSavedOrder() {
  try {
    const raw = localStorage.getItem(PROJECT_ORDER_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch (e) { return null; }
}
function saveOrder(ids) {
  try { localStorage.setItem(PROJECT_ORDER_KEY, JSON.stringify(ids)); } catch (e) { /* 存不進去就算了，不影響當次操作 */ }
}
function getOrderedProjects() {
  const saved = getSavedOrder();
  if (!saved) return PROJECTS;
  const byId = new Map(PROJECTS.map((p) => [p.id, p]));
  const ordered = saved.map((id) => byId.get(id)).filter(Boolean);
  // 設定檔裡有、但還沒出現在你排過的順序裡的專案（例如之後新增的），補到最後面
  PROJECTS.forEach((p) => { if (!saved.includes(p.id)) ordered.push(p); });
  return ordered;
}

function renderProjectTabs() {
  const bar = document.getElementById('projectTabs');
  bar.innerHTML = '';
  const orderedProjects = getOrderedProjects();

  orderedProjects.forEach((p) => {
    const tab = document.createElement('div');
    const ready = getCampaignIds(p).length > 0;
    tab.className = 'ptab' + (p.id === state.projectId ? ' active' : '') + (ready ? '' : ' disabled');
    tab.draggable = true;
    tab.innerHTML = `<span class="ptab-drag" title="拖曳調整順序">⠿</span><span class="ptab-label">${escapeHtml(p.name)}${ready ? '' : '（尚未設定）'}</span>`;

    if (ready) {
      tab.querySelector('.ptab-label').addEventListener('click', () => {
        state.projectId = p.id;
        state.postFilter = 'all';
        sortState.key = null;
        renderProjectTabs();
        updateHeader();
        renderPostFilter();
        updateDateDisplay();
        loadReport();
        loadOverview();
      });
    }

    // 拖曳排序：只認左邊的 ⠿ 把手，避免點名稱時不小心誤觸拖曳
    let dragAllowed = false;
    tab.addEventListener('mousedown', (e) => { dragAllowed = !!e.target.closest('.ptab-drag'); });
    tab.addEventListener('dragstart', (e) => {
      if (!dragAllowed) { e.preventDefault(); return; }
      tab.classList.add('dragging');
      e.dataTransfer.setData('text/plain', p.id);
    });
    tab.addEventListener('dragend', () => {
      tab.classList.remove('dragging');
      bar.querySelectorAll('.ptab').forEach((t) => t.classList.remove('drag-over'));
    });
    tab.addEventListener('dragover', (e) => { e.preventDefault(); tab.classList.add('drag-over'); });
    tab.addEventListener('dragleave', () => tab.classList.remove('drag-over'));
    tab.addEventListener('drop', (e) => {
      e.preventDefault();
      tab.classList.remove('drag-over');
      const draggedId = e.dataTransfer.getData('text/plain');
      if (!draggedId || draggedId === p.id) return;
      const currentOrder = orderedProjects.map((x) => x.id);
      const fromIdx = currentOrder.indexOf(draggedId);
      const toIdx = currentOrder.indexOf(p.id);
      if (fromIdx === -1 || toIdx === -1) return;
      currentOrder.splice(toIdx, 0, currentOrder.splice(fromIdx, 1)[0]);
      saveOrder(currentOrder);
      renderProjectTabs();
    });

    bar.appendChild(tab);
  });
}

