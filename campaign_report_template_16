<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>成效報表</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<style>
  :root{
    --bg-page:#f4f5f9; --bg-panel:#ffffff; --bg-soft:#eef0f5; --line:#e3e6ee;
    --text-0:#272b35; --text-1:#5a6272; --text-2:#9399a8;
    --accent:#7590c4; --accent-soft:#7590c414; --accent-line:#7590c440;
    --danger:#d18a97; --teal-ok:#7fae9a; --sans:'Inter',-apple-system,"PingFang TC","Noto Sans TC",sans-serif;
    --display:'Sora', var(--sans); --mono:'JetBrains Mono',Consolas,monospace; --radius:14px;
  }
  *{box-sizing:border-box;}
  body{margin:0; background:var(--bg-page); color:var(--text-0); font-family:var(--sans); min-height:100vh;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 20px 60px;}

  .topbar{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;
    padding:20px 20px; background:var(--bg-panel); border-bottom:1px solid var(--line);
    position:sticky; top:0; z-index:20;
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand-mark{
    width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg, var(--accent), #8FB8D9);
    display:flex; align-items:center; justify-content:center; color:#fff; font-family:var(--display);
    font-weight:800; font-size:15px; flex:none;
  }
  .brand-text h1{font-family:var(--display); font-size:17px; font-weight:700; margin:0;}
  .brand-text .sub{font-size:12px; color:var(--text-2); margin-top:1px; font-family:var(--mono);}
  .backlink{font-size:13px; color:var(--accent); text-decoration:none; font-weight:500;}
  .backlink:hover{text-decoration:underline;}

  .projecttabs{display:flex; gap:6px; flex-wrap:wrap; padding:12px 20px; background:var(--bg-panel); border-bottom:1px solid var(--line);}
  .ptab{padding:7px 13px; border-radius:8px; font-size:12.5px; font-weight:500; color:var(--text-1); cursor:pointer; border:1px solid transparent; display:flex; align-items:center; gap:6px;}
  .ptab:hover{background:var(--bg-soft);}
  .ptab.active{background:var(--accent-soft); color:var(--accent); border-color:var(--accent-line);}
  .ptab.disabled{color:var(--text-2); cursor:not-allowed; opacity:.55;}
  .ptab.dragging{opacity:.4;}
  .ptab.drag-over{border-color:var(--accent);}
  .ptab-drag{cursor:grab; color:var(--text-2); font-size:13px;}
  .ptab-drag:hover{color:var(--accent);}
  .ptab-label{cursor:pointer;}

  .controlsbar{
    display:flex; align-items:center; gap:10px; flex-wrap:wrap; padding:14px 20px;
    background:var(--bg-panel); border-bottom:1px solid var(--line);
  }
  .presetgroup{display:flex; gap:4px; background:var(--bg-soft); border-radius:9px; padding:3px;}
  .presetbtn{
    border:none; background:transparent; padding:6px 11px; border-radius:7px; font-size:12.5px;
    color:var(--text-1); cursor:pointer; font-family:var(--sans); font-weight:500;
  }
  .presetbtn.active{background:var(--bg-panel); color:var(--accent); box-shadow:0 1px 2px #0001;}
  .dateinputs{display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-2);}
  .dateinputs input{
    border:1px solid var(--line); border-radius:7px; padding:5px 8px; font-family:var(--mono); font-size:12.5px;
    color:var(--text-0);
  }
  .detailtoolbar{padding:12px 20px; display:flex; justify-content:flex-end;}
  .postfilter{display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-2);}
  .postfilter select{
    border:1px solid var(--line); border-radius:7px; padding:5px 8px; font-size:12.5px;
    color:var(--text-0); font-family:var(--sans); max-width:260px;
  }
  .refreshbtn{
    background:var(--accent); color:#fff; border:none; border-radius:9px; padding:8px 16px;
    font-size:13px; font-weight:500; cursor:pointer; font-family:var(--sans);
  }
  .refreshbtn:hover{filter:brightness(1.08);}
  .refreshbtn:disabled{opacity:.6; cursor:wait;}
  .updated{font-size:11.5px; color:var(--text-2); font-family:var(--mono); margin-left:auto;}

  .viewtabs{display:flex; gap:6px; flex-wrap:wrap; padding:16px 20px 0;}
  .vtab{
    padding:9px 16px; border-radius:9px 9px 0 0; font-size:13px; font-weight:500; color:var(--text-1);
    cursor:pointer; border:1px solid var(--line); border-bottom:none; background:var(--bg-soft);
  }
  .vtab.active{background:var(--bg-panel); color:var(--accent); border-color:var(--line);}

  .panel{background:var(--bg-panel); border:1px solid var(--line); border-radius:0 0 var(--radius) var(--radius); padding:0; margin-bottom:22px; overflow:hidden;}

  .stats-strip{display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:1px; background:var(--line); border-bottom:1px solid var(--line);}
  .stat-mini{background:var(--bg-panel); padding:14px 16px;}
  .stat-mini label{display:block; font-size:11px; color:var(--text-2); margin-bottom:4px;}
  .stat-mini .v{font-family:var(--mono); font-size:16px; font-weight:600;}

  .chartwrap{padding:18px 20px; border-bottom:1px solid var(--line);}
  .chartgrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px;}
  .chartcard{background:var(--bg-soft); border-radius:10px; padding:14px; height:260px; display:flex; flex-direction:column;}
  .chartcard h4{margin:0 0 8px; font-size:12px; color:var(--text-1); font-weight:600;}
  .chartcard .canvaswrap{flex:1; position:relative; min-height:0;}
  .chartcard .nodata{display:flex; align-items:center; justify-content:center; height:100%; color:var(--text-2); font-size:12px;}
  .overview-note{
    background:var(--bg-soft); border-radius:10px; padding:14px 16px; font-size:12.5px; color:var(--text-1);
    line-height:1.7; margin-top:16px;
  }
  .overview-note b{color:var(--text-0);}

  .overview-region{padding:18px 20px 22px; background:var(--bg-panel); border-bottom:1px solid var(--line);}
  .overview-stats{display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:12px; margin-bottom:16px;}
  .overview-stat{background:var(--bg-soft); border-radius:10px; padding:14px 16px;}
  .overview-stat label{display:block; font-size:11.5px; color:var(--text-2); margin-bottom:6px;}
  .overview-stat .v{font-family:var(--mono); font-size:19px; font-weight:600;}
  .overview-stat .delta{font-size:11px; margin-top:5px; font-family:var(--mono);}
  .overview-stat .delta.up{color:var(--teal-ok, #0f8f74);}
  .overview-stat .delta.down{color:var(--danger);}
  .overview-charts-row{display:grid; grid-template-columns:2fr 1fr; gap:16px;}
  @media (max-width:720px){ .overview-charts-row{grid-template-columns:1fr;} }

  table{width:100%; border-collapse:collapse; font-size:13px;}
  thead th{
    text-align:right; font-size:11px; color:var(--text-2); text-transform:uppercase; letter-spacing:.03em;
    padding:12px 14px; border-bottom:1px solid var(--line); font-weight:600; white-space:nowrap; background:var(--bg-soft);
  }
  thead th:first-child, tbody td:first-child{text-align:left;}
  .info-icon{
    display:inline-block; margin-left:4px; cursor:help; color:var(--text-2); font-size:11px;
    text-transform:none; letter-spacing:normal; font-weight:400;
  }
  .info-icon:hover{color:var(--accent);}
  .overview-stat label .info-icon{margin-left:5px;}
  th.sortable{cursor:pointer; user-select:none;}
  th.sortable:hover{color:var(--accent);}
  tbody td{padding:11px 14px; border-bottom:1px solid var(--line); font-family:var(--mono); text-align:right; white-space:nowrap;}
  tbody tr:hover{background:var(--bg-soft);}
  tbody tr.totalrow{font-weight:700; background:var(--accent-soft);}
  tbody tr.totalrow td{border-top:2px solid var(--accent-line);}
  .tablewrap{overflow-x:auto;}
  .thumb-box{
    width:72px; height:72px; border-radius:8px; border:1.5px dashed var(--line); background:var(--bg-soft);
    display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:10.5px;
    color:var(--text-2); text-align:center; line-height:1.3; overflow:hidden; position:relative;
  }
  .thumb-box:hover{border-color:var(--accent); color:var(--accent);}
  .thumb-box.has-img{border-style:solid; border-color:var(--line); padding:0; cursor:default; background:repeating-conic-gradient(#f4f6fb 0% 25%, #eaedf6 0% 50%) 50% / 12px 12px;}
  .thumb-box.has-img img{width:100%; height:100%; display:block; pointer-events:none;}
  .thumb-fit-toggle{
    position:absolute; right:2px; bottom:2px; width:18px; height:18px; border-radius:5px; border:none;
    background:#171b26cc; color:#fff; font-size:10px; line-height:1; cursor:pointer; display:flex;
    align-items:center; justify-content:center;
  }
  .thumb-fit-toggle:hover{background:#171b26;}
  .thumb-del{
    position:absolute; right:2px; top:2px; width:18px; height:18px; border-radius:5px; border:none;
    background:#d1435fcc; color:#fff; font-size:11px; line-height:1; cursor:pointer; display:flex;
    align-items:center; justify-content:center;
  }
  .thumb-del:hover{background:var(--danger);}

  .statebox{padding:60px 20px; text-align:center; color:var(--text-2); font-size:13px;}
  .statebox.error{color:var(--danger);}
  .snapshot-banner{
    display:flex; align-items:center; gap:10px; padding:10px 16px; background:#fff7e8; color:#8a5a00;
    border-bottom:1px solid #f0dcae; font-size:12.5px;
  }
</style>
</head>
