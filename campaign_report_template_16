let chartInstances = [];
const CHART_PALETTE = ['#8FB8D9', '#F0B88F', '#B5A8D5', '#E5A3BE', '#D9CB8F', '#9DC9B7', '#C9A0C4', '#A8C48A'];
const AGE_ORDER = ['18-24', '25-34', '35-44', '45-54', '55-64', '65+'];

function destroyCharts() {
  chartInstances.forEach((c) => c.destroy());
  chartInstances = [];
}

function addChartCard(gridEl, title, buildConfig) {
  const card = document.createElement('div');
  card.className = 'chartcard';
  card.innerHTML = `<h4>${escapeHtml(title)}</h4><div class="canvaswrap"><canvas></canvas></div>`;
  gridEl.appendChild(card);
  const config = buildConfig();
  if (!config) {
    card.querySelector('.canvaswrap').innerHTML = '<div class="nodata">尚無資料</div>';
    return;
  }
  const canvas = card.querySelector('canvas');
  const chart = new Chart(canvas.getContext('2d'), config);
  chartInstances.push(chart);
}

function hasAnyPurchases(rows) {
  return (rows || []).some((r) => (r.purchases || 0) > 0);
}

