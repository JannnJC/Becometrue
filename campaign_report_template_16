    });
    overviewCharts.push(trend);
  } else {
    trendCanvas.parentElement.innerHTML = '<div class="nodata">尚無資料</div>';
  }

  if (postData && postData.rows && postData.rows.length) {
    const donut = new Chart(donutCanvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: postData.rows.map((r) => (r.goal ? `${r.label}(${r.goal})` : r.label)),
        datasets: [{ data: postData.rows.map((r) => r.spend), backgroundColor: CHART_PALETTE, borderWidth: 0 }],
      },
      options: { responsive: true, maintainAspectRatio: false, cutout: '55%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } } },
    });
    overviewCharts.push(donut);
  } else {
    donutCanvas.parentElement.innerHTML = '<div class="nodata">尚無資料</div>';
  }
}

async function loadOverview() {
  const project = getActiveProject();
  const region = document.getElementById('overviewRegion');

  if (!getCampaignIds(project).length) {
    region.style.display = 'none';
    return;
  }
  region.style.display = 'block';

  const backendReady = !BACKEND_URL.includes('YOUR-SUBDOMAIN');
  const snapshot = SNAPSHOTS[project.id];

  if (!backendReady) {
    if (!snapshot) {
      renderOverviewStats(null, null);
      renderOverviewTrendAndDonut(null, null);
      return;
    }
    // 快照模式沒有「上一期」資料可以比較，統計卡只顯示數字，變化率留白
    renderOverviewStats(snapshot.data.all.post.totals, null);
    renderOverviewTrendAndDonut(snapshot.data.all.daily, snapshot.data.all.post);
    return;
  }

  try {
    const trendRange = { preset: 'last7' }; // 每日趨勢固定只看近7天，避免選「總走期」時長條圖被拉得又長又難讀
    const [postRes, dailyRes] = await Promise.all([
      fetch(buildOverviewUrl(project, 'post')),
      fetch(buildOverviewUrl(project, 'daily', null, trendRange)),
    ]);
    const postJson = await postRes.json();
    const dailyJson = await dailyRes.json();
    if (postJson.error) throw new Error(postJson.error);
    if (dailyJson.error) throw new Error(dailyJson.error);
    const postData = mergePostRows(project, postJson.rows);

    let prevTotals = null;
    try {
      const prevRange = computePrevRange(postJson.since, postJson.until);
      const prevRes = await fetch(buildOverviewUrl(project, 'post', prevRange));
      const prevJson = await prevRes.json();
      if (!prevJson.error) prevTotals = prevJson.totals;
    } catch (e) {
      // 拿不到上一期資料就不顯示變化率，不影響主要數字
    }

    renderOverviewStats(postData.totals, prevTotals);
    renderOverviewTrendAndDonut(dailyJson, postData);
  } catch (err) {
    document.getElementById('overviewStats').innerHTML = `<div class="statebox error">總覽讀取失敗：${escapeHtml(err.message)}</div>`;
  }
}

function renderTable(view, data, isSnapshot, snapshot, ctx) {
  const wrap = document.getElementById('tableWrap');
  const banner = isSnapshot
    ? `<div class="snapshot-banner">📸 這是 ${escapeHtml(snapshot.fetchedAt)} 抓取的快照資料（${escapeHtml(snapshot.since)} ~ ${escapeHtml(snapshot.until)}），不會自動更新。接上後端後會自動變成即時資料。</div>`
    : '';

  renderChart(view, data, ctx);

  if (view === 'post') {
    const theadCols = [`<th class="sortable" data-sort-key="__label">貼文${sortArrow('__label')}</th>`, '<th>優化目標</th>', '<th>狀態</th>', '<th>預算</th>', '<th>走期</th>', ...metricHeaderCells(METRIC_COLS)].join('');
    const bodyRows = data.rows.map((row) => {
      const status = row.spend > 0 || row.impressions > 0 ? '投放中' : '尚未開始曝光';
      const cells = METRIC_COLS.map((c) => `<td>${fmtCell(c, row[c.key])}</td>`).join('');
      return `<tr><td>${escapeHtml(row.label)}</td><td>${escapeHtml(row.goal || '—')}</td><td>${status}</td><td>${row.planBudget ? 'NT$' + fmtNum(row.planBudget) : '—'}</td><td>${escapeHtml(row.planDates || '—')}</td>${cells}</tr>`;
    }).join('');
    const totalCells = METRIC_COLS.map((c) => `<td>${fmtCell(c, data.totals[c.key])}</td>`).join('');
    wrap.innerHTML = `
      ${banner}
      <table>
        <thead><tr>${theadCols}</tr></thead>
        <tbody>
          ${bodyRows || '<tr><td colspan="' + (METRIC_COLS.length + 4) + '" style="text-align:center;color:var(--text-2);">這個專案還沒有任何已建立的廣告活動</td></tr>'}
          <tr class="totalrow"><td>總計</td><td></td><td></td><td></td><td></td>${totalCells}</tr>
        </tbody>
      </table>
    `;
    attachSortHandlers(wrap, 'post');
    return;
  }

  if (view === 'ad') {
    renderAdTable(data, banner);
    return;
  }

  const firstLabel = FIRST_COL_LABEL[view];
  const theadCols = [`<th class="sortable" data-sort-key="__label">${firstLabel}${sortArrow('__label')}</th>`, ...metricHeaderCells(METRIC_COLS)].join('');
  const bodyRows = data.rows.map((row) => {
    const cells = METRIC_COLS.map((c) => `<td>${fmtCell(c, row[c.key])}</td>`).join('');
    return `<tr><td>${escapeHtml(labelForRow(view, row))}</td>${cells}</tr>`;
  }).join('');
  const totalCells = METRIC_COLS.map((c) => `<td>${fmtCell(c, data.totals[c.key])}</td>`).join('');
  const placementNote = view === 'placement'
    ? '<div class="overview-note" style="margin:16px 20px 0;">目前這個專案的投遞平台是 <b>Facebook</b>（用 publisher_platform 拆解確認過，還沒有用到 Instagram / Threads 版位）。之後如果開始投 IG 或 Threads，版位名稱會自動顯示對應平台。</div>'
    : '';

  wrap.innerHTML = `
    ${banner}
    <table>
      <thead><tr>${theadCols}</tr></thead>
      <tbody>
        ${bodyRows || '<tr><td colspan="' + (METRIC_COLS.length + 1) + '" style="text-align:center;color:var(--text-2);">這段期間沒有資料</td></tr>'}
        <tr class="totalrow"><td>總計</td>${totalCells}</tr>
      </tbody>
    </table>
    ${placementNote}
  `;
  attachSortHandlers(wrap, view);
}

function escapeHtml(s) {
  return (s || '').toString().replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function setUpdatedNow() {
  const now = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  document.getElementById('updatedAt').textContent =
    `最後更新 ${now.getFullYear()}/${pad(now.getMonth() + 1)}/${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}（此頁開著時每4小時自動更新一次）`;
}

async function loadReport() {
  const project = getActiveProject();
  const wrap = document.getElementById('tableWrap');
  const btn = document.getElementById('refreshBtn');
  const statsStrip = document.getElementById('statsStrip');

  if (!getCampaignIds(project).length) {
    wrap.innerHTML = '<div class="statebox">這個專案還沒有設定任何廣告活動 ID，暫時無法拉取資料。</div>';
    statsStrip.innerHTML = '';
    return;
  }

  const backendReady = !BACKEND_URL.includes('YOUR-SUBDOMAIN');
  const snapshot = SNAPSHOTS[project.id];
  const scopeKey = state.postFilter;

  // 還沒接後端：如果有快照，先顯示快照；沒有快照就提示還沒設定
  if (!backendReady) {
    if (!snapshot) {
      wrap.innerHTML = '<div class="statebox error">還沒有設定後端網址，這個專案也還沒有快照資料。</div>';
      statsStrip.innerHTML = '';
      return;
    }
    let data;
    if (state.view === 'post' && scopeKey !== 'all') {
      // 快照只有「全部貼文」的貼文清單，篩選特定一篇時用同一份清單過濾出那一列
      data = filterPostDataByCampaign(snapshot.data.all.post, scopeKey);
    } else {
      const scoped = snapshot.data[scopeKey];
      data = scoped && scoped[state.view];
    }
    if (!data) {
      wrap.innerHTML = '<div class="statebox">這個快照還沒有包含這個篩選條件 / 分頁的資料。</div>';
      statsStrip.innerHTML = '';
      return;
    }
    const chartCtx = {
      getPostDaily: (campaignId) => (snapshot.data[campaignId] ? snapshot.data[campaignId].daily.rows : []),
      getPostData: () => snapshot.data.all.post,
    };
    renderTableSorted({ view: state.view, data, isSnapshot: true, snapshot, ctx: chartCtx });
    document.getElementById('updatedAt').textContent = `快照抓取於 ${snapshot.fetchedAt}（${snapshot.since} ~ ${snapshot.until}，尚未接上即時後端）`;
    return;
  }

  btn.disabled = true;
  wrap.innerHTML = '<div class="statebox">正在從 Meta API 抓取資料…</div>';

  try {
    const res = await fetch(buildUrl(project));
    const data = await res.json();
    if (data.error) throw new Error(data.error);

    // 「貼文」視圖：把後端回來的真實活動數字，跟你自己填的貼文清單合併起來；
    // 如果篩選貼文選了特定一篇，貼文分頁也只顯示那一篇（不再固定顯示全部）
    const renderData = state.view === 'post'
      ? mergePostRows(project, data.rows, state.postFilter === 'all' ? null : state.postFilter)
      : data;

    const chartCtx = { getPostDaily: () => [], getPostData: () => renderData };

    // Daily + 全部貼文：額外平行抓每篇貼文自己的逐日資料，畫多線圖用
    if (state.view === 'daily' && state.postFilter === 'all') {
      const posts = (project.posts || []).filter((p) => p.campaignId);
      const results = await Promise.all(posts.map(async (p) => {
        try {
          const url = new URL(`${BACKEND_URL}/api/campaign-report`);
          url.searchParams.set('account_id', project.accountId);
          url.searchParams.set('campaign_ids', p.campaignId);
          url.searchParams.set('view', 'daily');
          if (state.since && state.until) {
            url.searchParams.set('since', state.since);
            url.searchParams.set('until', state.until);
          } else {
            url.searchParams.set('preset', state.preset);
          }
          const r = await fetch(url.toString());
          const j = await r.json();
          return [p.campaignId, j.rows || []];
        } catch (e) {
          return [p.campaignId, []];
        }
      }));
      const dailyMap = new Map(results);
      chartCtx.getPostDaily = (campaignId) => dailyMap.get(campaignId) || [];
    }

    renderTableSorted({ view: state.view, data: renderData, isSnapshot: false, snapshot: null, ctx: chartCtx });
    setUpdatedNow();
  } catch (err) {
    wrap.innerHTML = `<div class="statebox error">讀取失敗：${escapeHtml(err.message)}</div>`;
    statsStrip.innerHTML = '';
  } finally {
    btn.disabled = false;
  }
}

document.getElementById('sinceInput').addEventListener('change', () => {
  state.since = document.getElementById('sinceInput').value;
});
document.getElementById('untilInput').addEventListener('change', () => {
  state.until = document.getElementById('untilInput').value;
  if (state.since && state.until) {
    renderPresetGroupCleared();
    loadReport();
    loadOverview();
  }
});
function renderPresetGroupCleared() {
  state.preset = '';
  renderPresetGroup();
}
document.getElementById('refreshBtn').addEventListener('click', () => {
  loadReport();
  loadOverview();
});
document.getElementById('postFilterSelect').addEventListener('change', (e) => {
  state.postFilter = e.target.value;
  sortState.key = null;
  loadReport();
});

renderProjectTabs();
updateHeader();
renderPresetGroup();
updateDateDisplay();
renderViewTabs();
renderPostFilter();
updatePostFilterEnabled();
loadReport();
loadOverview();

/* ---------------- 自動更新（只有接上真後端才有意義；快照模式下每次重跑都是同一份資料，所以自動跳過） ---------------- */
const AUTO_REFRESH_MS = 4 * 60 * 60 * 1000; // 4 小時
setInterval(() => {
  const backendReady = !BACKEND_URL.includes('YOUR-SUBDOMAIN');
  if (!backendReady) return; // 快照模式：重新整理也不會有新資料，不用浪費請求
  loadReport();
  loadOverview();
}, AUTO_REFRESH_MS);
</script>
