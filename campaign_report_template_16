/* Daily 分頁：改成多線圖，每篇貼文各自一條線（花費），另外疊一條淺色虛線代表該貼文的「日均預算」參考線，
   右側副座標軸再疊一條「購買」加總線。 */
function renderDailyChart(grid, ctx, combinedData) {
  const project = getActiveProject();
  const posts = (project.posts || []).filter((p) => p.campaignId);

  // 只看單一貼文時：維持單線 + 花費/曝光雙軸（跟原本一樣直覺）
  if (state.postFilter !== 'all') {
    addChartCard(grid, 'Daily 走勢（花費 / 曝光）', () => ({
      data: {
        labels: combinedData.rows.map((r) => r.label),
        datasets: [
          { type: 'bar', label: '花費金額', data: combinedData.rows.map((r) => r.spend), backgroundColor: CHART_PALETTE[0], borderRadius: 4, yAxisID: 'y' },
          { type: 'line', label: '曝光', data: combinedData.rows.map((r) => r.impressions), borderColor: CHART_PALETTE[2], backgroundColor: CHART_PALETTE[2], tension: 0.3, yAxisID: 'y1' },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
        scales: {
          y: { position: 'left', title: { display: true, text: '花費金額', font: { size: 11 } }, ticks: { font: { size: 10 } } },
          y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: '曝光', font: { size: 11 } }, ticks: { font: { size: 10 } } },
          x: { ticks: { font: { size: 10 } } },
        },
      },
    }));
    return;
  }

  // 全部貼文：每篇貼文各一條花費線 + 日均預算參考線 + 購買加總線
  addChartCard(grid, '各貼文每日花費走勢（虛線＝該貼文日均預算）', () => {
    const perPost = posts.map((p, idx) => {
      const rows = ctx.getPostDaily(p.campaignId);
      return { post: p, rows, color: CHART_PALETTE[idx % CHART_PALETTE.length] };
    }).filter((p) => p.rows && p.rows.length);
    if (!perPost.length) return null;

    const allDates = Array.from(new Set(perPost.flatMap((p) => p.rows.map((r) => r.key)))).sort();
    const datasets = [];
    perPost.forEach((p) => {
      const byDate = new Map(p.rows.map((r) => [r.key, r.spend]));
      datasets.push({
        label: p.post.goal ? `${p.post.label}(${p.post.goal})` : p.post.label,
        data: allDates.map((d) => byDate.get(d) ?? null),
        borderColor: p.color, backgroundColor: p.color, tension: 0.3, spanGaps: true,
      });
      if (p.post.planBudget && allDates.length) {
        const dayCount = p.rows.length || 1;
        const dailyPace = Math.round(p.post.planBudget / Math.max(dayCount, 1));
        datasets.push({
          label: `${p.post.label} 日均預算`, data: allDates.map(() => dailyPace),
          borderColor: p.color, borderDash: [4, 4], borderWidth: 1, pointRadius: 0, backgroundColor: 'transparent',
        });
      }
    });

    return {
      type: 'line',
      data: { labels: allDates, datasets },
      options: {
        responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } },
        scales: {
          y: { beginAtZero: true, title: { display: true, text: '花費金額', font: { size: 11 } }, ticks: { font: { size: 10 } } },
          x: { ticks: { font: { size: 10 } } },
        },
      },
    };
  });

  addChartCard(grid, '每日購買數（全部貼文加總）', () => {
    if (!hasAnyPurchases(combinedData.rows)) return null;
    return {
      type: 'bar',
      data: { labels: combinedData.rows.map((r) => r.label), datasets: [{ label: '購買數', data: combinedData.rows.map((r) => r.purchases), backgroundColor: CHART_PALETTE[2], borderRadius: 4 }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 10 } } } },
      },
    };
  });
}

/* ================= 頁面頂部常駐的「總覽」區塊（不是分頁，跟你選哪個 Sheet 無關，只跟日期區間有關） ================= */

let overviewCharts = [];

function pctChange(cur, prev) {
  if (prev === null || prev === undefined || prev === 0 || cur === null || cur === undefined) return null;
  return ((cur - prev) / prev) * 100;
}

function fmtCompact(n) {
  n = n || 0;
  if (n >= 10000) return (n / 10000).toFixed(1) + '萬';
  return fmtNum(n);
}

function computePrevRange(since, until) {
  const s = new Date(since + 'T00:00:00Z');
  const u = new Date(until + 'T00:00:00Z');
  const days = Math.round((u - s) / 86400000) + 1;
  const prevUntil = new Date(s);
  prevUntil.setUTCDate(prevUntil.getUTCDate() - 1);
  const prevSince = new Date(prevUntil);
  prevSince.setUTCDate(prevSince.getUTCDate() - (days - 1));
  const fmt = (d) => d.toISOString().slice(0, 10);
  return { since: fmt(prevSince), until: fmt(prevUntil) };
}

function buildOverviewUrl(project, view, rangeOverride, presetOverride) {
  const params = new URLSearchParams();
  params.set('account_id', project.accountId);
  params.set('campaign_ids', getCampaignIds(project).join(','));
  params.set('view', view);
  if (presetOverride) {
    params.set('preset', presetOverride.preset);
  } else if (rangeOverride) {
    params.set('since', rangeOverride.since);
    params.set('until', rangeOverride.until);
  } else if (state.since && state.until) {
    params.set('since', state.since);
    params.set('until', state.until);
  } else {
    params.set('preset', state.preset);
  }
  return `${BACKEND_URL}/api/campaign-report?${params.toString()}`;
}

function renderOverviewStats(totals, prevTotals) {
  const el = document.getElementById('overviewStats');
  if (!totals) { el.innerHTML = ''; return; }
  const cpa = totals.purchases > 0 ? Math.round(totals.spend / totals.purchases) : null;
  const prevCpa = prevTotals && prevTotals.purchases > 0 ? Math.round(prevTotals.spend / prevTotals.purchases) : null;
  const items = [
    { label: '花費', def: METRIC_DEFINITIONS.spend, v: 'NT$' + fmtNum(totals.spend), delta: pctChange(totals.spend, prevTotals && prevTotals.spend), lowerIsBetter: true },
    { label: '曝光', def: METRIC_DEFINITIONS.impressions, v: fmtCompact(totals.impressions), delta: pctChange(totals.impressions, prevTotals && prevTotals.impressions) },
    { label: '加入購物車', def: METRIC_DEFINITIONS.add_to_cart, v: fmtNum(totals.add_to_cart), delta: pctChange(totals.add_to_cart, prevTotals && prevTotals.add_to_cart) },
    { label: '購買', def: METRIC_DEFINITIONS.purchases, v: fmtNum(totals.purchases), delta: pctChange(totals.purchases, prevTotals && prevTotals.purchases) },
    { label: '轉換值', def: METRIC_DEFINITIONS.purchase_value, v: 'NT$' + fmtNum(totals.purchase_value), delta: pctChange(totals.purchase_value, prevTotals && prevTotals.purchase_value) },
    { label: 'ROAS', def: METRIC_DEFINITIONS.roas, v: totals.roas + 'x', delta: pctChange(totals.roas, prevTotals && prevTotals.roas) },
    { label: 'CPA（購買）', def: 'CPA（購買）＝ 花費金額 ÷ 購買數，平均每一次購買花了多少廣告費。', v: cpa !== null ? 'NT$' + fmtNum(cpa) : '—', delta: (cpa !== null && prevCpa !== null) ? pctChange(cpa, prevCpa) : null, lowerIsBetter: true },
  ];
  el.innerHTML = items.map((it) => {
    let deltaHtml = '<div class="delta" style="color:var(--text-2);">上期比較：無資料</div>';
    if (it.delta !== null && isFinite(it.delta)) {
      const goodDirection = it.lowerIsBetter ? it.delta <= 0 : it.delta >= 0;
      const cls = goodDirection ? 'up' : 'down';
      const sign = it.delta > 0 ? '+' : '';
      deltaHtml = `<div class="delta ${cls}">${sign}${it.delta.toFixed(1)}%</div>`;
    }
    const info = it.def ? `<span class="info-icon" title="${escapeHtml(it.def)}">ⓘ</span>` : '';
    return `<div class="overview-stat"><label>${it.label}${info}</label><div class="v">${it.v}</div>${deltaHtml}</div>`;
  }).join('');
}

