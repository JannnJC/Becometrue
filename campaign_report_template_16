// 快照模式專用：從「全部貼文」那份清單裡，篩出單一 campaignId 對應的那一列，重新算 totals
function filterPostDataByCampaign(postData, campaignId) {
  const row = (postData.rows || []).find((r) => r.key === campaignId);
  if (!row) return { rows: [], totals: postData.totals };
  const totals = { ...row };
  delete totals.key;
  delete totals.label;
  delete totals.goal;
  delete totals.planBudget;
  delete totals.planDates;
  delete totals.missing;
  return { rows: [row], totals };
}

function mergePostRows(project, liveRows, campaignFilter) {
  const byId = new Map((liveRows || []).map((r) => [r.key, r]));
  const zero = { impressions: 0, reach: 0, clicks: 0, link_clicks: 0, cpc_all: 0, cpc_link: 0, cpm: 0, ctr_all: 0, add_to_cart: 0, purchases: 0, purchase_value: 0, roas: 0, spend: 0 };

  // 尚未建立廣告活動（campaignId 是 null）的貼文，直接不顯示；同名（且同優化目標）的貼文合併加總，不重複列出；
  // 如果有指定 campaignFilter（例如上方篩選貼文選了特定一篇），就只保留那一篇
  const grouped = new Map();
  (project.posts || [])
    .filter((p) => !!p.campaignId)
    .filter((p) => !campaignFilter || p.campaignId === campaignFilter)
    .forEach((p) => {
      const live = byId.get(p.campaignId) || zero;
      const key = `${p.label}|${p.goal || ''}`;
      if (!grouped.has(key)) {
        grouped.set(key, { label: p.label, goal: p.goal, planBudget: 0, planDatesList: [], ...zero });
      }
      const g = grouped.get(key);
      g.planBudget += p.planBudget || 0;
      g.planDatesList.push(p.planDates);
      Object.keys(zero).forEach((k) => { g[k] += live[k] || 0; });
    });

  const rows = [...grouped.values()].map((g) => ({
    label: g.label,
    goal: g.goal,
    planBudget: g.planBudget,
    planDates: g.planDatesList.join('、'),
    missing: false,
    impressions: g.impressions, reach: g.reach, clicks: g.clicks, link_clicks: g.link_clicks,
    add_to_cart: g.add_to_cart, purchases: g.purchases, purchase_value: g.purchase_value, spend: g.spend,
    ctr_all: g.impressions > 0 ? Math.round((g.clicks / g.impressions) * 10000) / 100 : 0,
    cpc_all: g.clicks > 0 ? Math.round((g.spend / g.clicks) * 100) / 100 : 0,
    cpm: g.impressions > 0 ? Math.round((g.spend / g.impressions) * 100000) / 100 : 0,
    cpc_link: g.link_clicks > 0 ? Math.round((g.spend / g.link_clicks) * 100) / 100 : 0,
    roas: g.spend > 0 ? Math.round((g.purchase_value / g.spend) * 100) / 100 : 0,
  }));

  const totals = rows.reduce((acc, r) => {
    Object.keys(zero).forEach((k) => { if (!['cpc_all', 'cpc_link', 'cpm', 'ctr_all', 'roas'].includes(k)) acc[k] = (acc[k] || 0) + (r[k] || 0); });
    return acc;
  }, {});
  totals.ctr_all = totals.impressions > 0 ? Math.round((totals.clicks / totals.impressions) * 10000) / 100 : 0;
  totals.cpc_all = totals.clicks > 0 ? Math.round((totals.spend / totals.clicks) * 100) / 100 : 0;
  totals.cpm = totals.impressions > 0 ? Math.round((totals.spend / totals.impressions) * 100000) / 100 : 0;
  totals.cpc_link = totals.link_clicks > 0 ? Math.round((totals.spend / totals.link_clicks) * 100) / 100 : 0;
  totals.roas = totals.spend > 0 ? Math.round((totals.purchase_value / totals.spend) * 100) / 100 : 0;
  return { rows, totals };
}

/* ---------------- 素材縮圖：存在瀏覽器本機（localStorage），换台電腦或清瀏覽器資料會不見，但同一台電腦重整不會消失 ---------------- */
const THUMB_PREFIX = 'ad_thumb_v1_';
const THUMB_FIT_PREFIX = 'ad_thumb_fit_v1_';
function thumbKeyFor(projectId, rowKey) {
  return THUMB_PREFIX + projectId + '_' + rowKey;
}
function getThumb(key) {
  try { return localStorage.getItem(key); } catch (e) { return null; }
}
function setThumb(key, dataUrl) {
  try { localStorage.setItem(key, dataUrl); return true; } catch (e) { return false; }
}
function deleteThumb(key) {
  try {
    localStorage.removeItem(key);
    localStorage.removeItem(THUMB_FIT_PREFIX + key);
  } catch (e) { /* 忽略 */ }
}
function getThumbFit(key) {
  try { return localStorage.getItem(THUMB_FIT_PREFIX + key) || 'contain'; } catch (e) { return 'contain'; }
}
function setThumbFit(key, fit) {
  try { localStorage.setItem(THUMB_FIT_PREFIX + key, fit); } catch (e) { /* 忽略 */ }
}

function renderAdTable(data, banner) {
  const wrap = document.getElementById('tableWrap');
  const theadCols = ['<th>縮圖</th>', `<th class="sortable" data-sort-key="__label">廣告${sortArrow('__label')}</th>`, ...metricHeaderCells(METRIC_COLS)].join('');
  const bodyRows = data.rows.map((row) => {
    const key = thumbKeyFor(state.projectId, row.key);
    const saved = getThumb(key);
    let thumbCell;
    if (saved) {
      const fit = getThumbFit(key);
      thumbCell = `
        <div class="thumb-box has-img" data-thumbkey="${escapeHtml(key)}">
          <img src="${saved}" alt="" style="object-fit:${fit};">
          <button type="button" class="thumb-del" data-thumbkey="${escapeHtml(key)}" title="刪除縮圖">×</button>
          <button type="button" class="thumb-fit-toggle" data-thumbkey="${escapeHtml(key)}" title="切換完整顯示／裁切填滿">⤢</button>
        </div>`;
    } else {
      thumbCell = `<div class="thumb-box" data-thumbkey="${escapeHtml(key)}">+ 上傳<br>縮圖</div>`;
    }
    const cells = METRIC_COLS.map((c) => `<td>${fmtCell(c, row[c.key])}</td>`).join('');
    return `<tr><td>${thumbCell}</td><td>${escapeHtml(row.label)}</td>${cells}</tr>`;
  }).join('');
  const totalCells = METRIC_COLS.map((c) => `<td>${fmtCell(c, data.totals[c.key])}</td>`).join('');

  wrap.innerHTML = `
    ${banner}
    <table>
      <thead><tr>${theadCols}</tr></thead>
      <tbody>
        ${bodyRows || '<tr><td colspan="' + (METRIC_COLS.length + 2) + '" style="text-align:center;color:var(--text-2);">這段期間沒有資料</td></tr>'}
        <tr class="totalrow"><td></td><td>總計</td>${totalCells}</tr>
      </tbody>
    </table>
    <input type="file" accept="image/*" id="thumbFileInput" style="display:none;">
  `;

  attachSortHandlers(wrap, 'ad');

  const fileInput = document.getElementById('thumbFileInput');

  wrap.querySelectorAll('.thumb-box:not(.has-img)').forEach((box) => {
    box.addEventListener('click', () => {
      const key = box.dataset.thumbkey;
      fileInput.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          const ok = setThumb(key, reader.result);
          if (!ok) {
            alert('圖片存不進去（通常是圖片太大或瀏覽器空間不足），建議換一張小一點的圖片再試一次。');
            return;
          }
          renderAdTable(data, banner);
        };
        reader.readAsDataURL(file);
      };
      fileInput.click();
    });
  });

  wrap.querySelectorAll('.thumb-del').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.thumbkey;
      if (!confirm('確定要刪除這張縮圖嗎？')) return;
      deleteThumb(key);
      renderAdTable(data, banner);
    });
  });

  wrap.querySelectorAll('.thumb-fit-toggle').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.thumbkey;
      const current = getThumbFit(key);
      setThumbFit(key, current === 'contain' ? 'cover' : 'contain');
      renderAdTable(data, banner);
    });
  });
}

