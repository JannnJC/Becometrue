// 純粹給右邊日期框顯示用，跟後端 getDateRange() 邏輯一致；不會影響實際查詢方式（還是用 preset 名稱送給後端）
// 把「8/11」這種簡寫日期轉成真正的日期物件（假設是今年）
function parseShortDate(str) {
  const parts = (str || '').trim().split('/');
  if (parts.length !== 2) return null;
  const month = parseInt(parts[0], 10);
  const day = parseInt(parts[1], 10);
  if (!month || !day) return null;
  return new Date(Date.UTC(new Date().getUTCFullYear(), month - 1, day));
}

// 找出這個專案裡，所有「已經建立廣告活動」的貼文中，走期最早的起始日
function getEarliestPlanDate(project) {
  const dates = [];
  (project.posts || []).filter((p) => p.campaignId && p.planDates).forEach((p) => {
    p.planDates.split('、').forEach((range) => {
      const d = parseShortDate((range || '').split('-')[0]);
      if (d) dates.push(d);
    });
  });
  if (!dates.length) return null;
  return new Date(Math.min(...dates.map((d) => d.getTime())));
}

// 純粹給右邊日期框顯示用，跟後端 getDateRange() 邏輯一致；不會影響實際查詢方式（還是用 preset 名稱送給後端）。
// 「總走期」「累計至昨日」這兩個技術上是從很早以前開始查（讓 Meta 自動裁到真正有資料的天數），
// 但畫面上改成顯示「這個專案最早的貼文走期」，不然客戶看到 2015-01-01 會很困惑。
function computePresetDisplayRange(presetKey, project) {
  const fmt = (d) => d.toISOString().slice(0, 10);
  const today = new Date();
  today.setUTCHours(0, 0, 0, 0);
  const earliest = project ? getEarliestPlanDate(project) : null;
  const earliestStr = earliest ? fmt(earliest) : '2015-01-01';
  switch (presetKey) {
    case 'today': return { since: fmt(today), until: fmt(today) };
    case 'yesterday': { const y = new Date(today); y.setUTCDate(y.getUTCDate() - 1); return { since: fmt(y), until: fmt(y) }; }
    case 'last7': { const s = new Date(today); s.setUTCDate(s.getUTCDate() - 6); return { since: fmt(s), until: fmt(today) }; }
    case 'thismonth': { const s = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)); return { since: fmt(s), until: fmt(today) }; }
    case 'lastmonth': {
      const s = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - 1, 1));
      const e = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 0));
      return { since: fmt(s), until: fmt(e) };
    }
    case 'alltime': return { since: earliestStr, until: fmt(today) };
    case 'todate': {
      const y = new Date(today);
      y.setUTCDate(y.getUTCDate() - 1);
      // 如果這個專案最早的貼文走期比「昨天」還晚（例如活動今天才剛開始），代表還沒有一個完整走完的天，
      // 這時候不要讓 since 超過 until（不然會出現像「8/13-8/12」這種顛倒的區間），改成兩邊都對齊到最早那天。
      const untilD = new Date(y);
      const sinceD = earliest && earliest.getTime() > untilD.getTime() ? earliest : (earliest || untilD);
      const finalUntil = sinceD.getTime() > untilD.getTime() ? sinceD : untilD;
      return { since: fmt(sinceD), until: fmt(finalUntil) };
    }
    default: return null;
  }
}

